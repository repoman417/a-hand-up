{"dependencies":{"drizzle-orm":"^0.44.0","react":"^19.0.0","react-dom":"^19.0.0"},"description":"Anonymous giving app: small asks, paid directly to the payee. No cash ever touches the asker.","devDependencies":{"@types/react":"^19.0.0","@types/react-dom":"^19.0.0"},"name":"a-hand-up","private":true,"scripts":{"build":"bun build ./client/app.tsx --outdir ./public --target browser --minify && cp ./client/index.html ./public/index.html","dev":"bun run build && bun src/server.ts","start":"bun src/server.ts","test":"bun scripts/test.ts"},"type":"module","version":"1.0.0"}